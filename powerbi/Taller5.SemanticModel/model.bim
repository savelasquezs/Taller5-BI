        ],
        "lineageTag": "59783618-188a-4ff6-9e9a-992d5cc4516e",
        "measures": [
          {
            "name": "Registros",
            "displayFolder": "Producción",
            "expression": "COUNTROWS(FactProduccion)",
            "formatString": "#,0",
            "lineageTag": "5ead52ba-6bb1-4ef8-afea-f79287213114"
          },
          {
            "name": "Pacas",
            "displayFolder": "Producción",
            "expression": "SUM(FactProduccion[pacas_producidas])",
            "formatString": "#,0",
            "lineageTag": "206dcf43-5230-45a1-9459-db44b7219896"
          },
          {
            "name": "Horas trabajadas",
            "displayFolder": "Producción",
            "expression": "SUM(FactProduccion[horas_trabajadas])",
            "formatString": "#,0.00",
            "lineageTag": "cbf4853a-dc42-424c-9398-6f7a77bf1365"
          },
          {
            "name": "Paros",
            "displayFolder": "Paros",
            "expression": "COUNTROWS(FactParos)",
            "formatString": "#,0",
            "lineageTag": "4b3ec028-1d10-4a6b-8507-47f89f44c887"
          },
          {
            "name": "Minutos de paro",
            "displayFolder": "Paros",
            "expression": "SUM(FactParos[duracion_minutos])",
            "formatString": "#,0.00",
            "lineageTag": "27d242a2-3a4b-459e-9e0e-906c3355643d"
          },
          {
            "name": "Horas de paro",
            "displayFolder": "Paros",
            "expression": "DIVIDE([Minutos de paro],60)",
            "formatString": "#,0.00",
            "lineageTag": "f46b7fc2-1ee3-433c-96ab-8fb2ebb005ab"
          },
          {
            "name": "Registros sin referencia",
            "displayFolder": "Calidad de datos",
            "expression": "CALCULATE([Registros], FactProduccion[referencia_id] = 0)",
            "formatString": "#,0",
            "lineageTag": "883d995c-f87e-4d4a-a8ff-c299b0fafeaa"
          },
          {
            "name": "Registros con OEE",
            "displayFolder": "Calidad de datos",
            "expression": "COALESCE(CALCULATE([Registros], FactProduccion[oee_valido] = TRUE()),0)",
            "formatString": "#,0",
            "lineageTag": "92fd9e78-73a1-407c-af87-7643c0b3f383"
          },
          {
            "name": "Cobertura OEE %",
            "displayFolder": "Calidad de datos",
            "expression": "DIVIDE([Registros con OEE],[Registros])",
            "formatString": "0.0%",
            "lineageTag": "d14a42dd-f691-4247-8b0d-abb79be366b9"
          },
          {
            "name": "Última fecha",
            "displayFolder": "Producción",
            "expression": "MAX(FactProduccion[fecha])",
            "formatString": "yyyy-MM-dd",
            "lineageTag": "365424c9-2f27-467a-948b-17deb7659908"
          },
          {
            "name": "Plan válido",
            "displayFolder": "OEE",
            "expression": "CALCULATE(SUM(FactProduccion[tiempo_planificado_minutos]), FactProduccion[oee_valido] = TRUE())",
            "formatString": "#,0.00",
            "lineageTag": "f866660e-c4a1-44a6-8f7c-b76905d04461"
          },
          {
            "name": "Operación válida",
            "displayFolder": "OEE",
            "expression": "CALCULATE(SUM(FactProduccion[minutos_operativos]), FactProduccion[oee_valido] = TRUE())",
            "formatString": "#,0.00",
            "lineageTag": "3ca592a9-be3e-4f8c-aa0e-f03584e75439"
          },
          {
            "name": "Tiempo ideal válido",
            "displayFolder": "OEE",
            "expression": "CALCULATE(SUM(FactProduccion[minutos_ideales]), FactProduccion[oee_valido] = TRUE())",
            "formatString": "#,0.00",
            "lineageTag": "97eca8a5-6091-4512-a120-a5193f16d121"
          },
          {
            "name": "Tiempo bueno ideal válido",
            "displayFolder": "OEE",
            "expression": "CALCULATE(SUM(FactProduccion[minutos_buenos_ideales]), FactProduccion[oee_valido] = TRUE())",
            "formatString": "#,0.00",
            "lineageTag": "57d816da-7640-48d4-83dc-748cfc48130a"
          },
          {
            "name": "Disponibilidad %",
            "displayFolder": "OEE",
            "expression": "DIVIDE(CALCULATE(SUM(FactProduccion[minutos_operativos]),FactProduccion[disponibilidad_valida]=TRUE()), CALCULATE(SUM(FactProduccion[tiempo_planificado_minutos]),FactProduccion[disponibilidad_valida]=TRUE()))",
            "formatString": "0.0%",
            "lineageTag": "d40af3c9-9f28-42fc-bb4f-ed6e41873e43"
          },
          {
            "name": "Rendimiento %",
            "displayFolder": "OEE",
            "expression": "DIVIDE(CALCULATE(SUM(FactProduccion[minutos_ideales]),FactProduccion[rendimiento_valido]=TRUE()), CALCULATE(SUM(FactProduccion[minutos_operativos]),FactProduccion[rendimiento_valido]=TRUE()))",
            "formatString": "0.0%",
            "lineageTag": "8e9d5f9d-63e1-4085-994e-7bec657e8109"
          },
          {
            "name": "Calidad OEE %",
            "displayFolder": "OEE",
            "expression": "DIVIDE([Tiempo bueno ideal válido],[Tiempo ideal válido])",
            "formatString": "0.0%",
            "lineageTag": "1555cb06-1358-4168-8932-41a311bc7d8c"
          },
          {
            "name": "Calidad unidades %",
            "displayFolder": "OEE",
            "expression": "DIVIDE(CALCULATE(SUM(FactProduccion[unidades_buenas]), FactProduccion[calidad_valida] = TRUE()), CALCULATE(SUM(FactProduccion[unidades_producidas]), FactProduccion[calidad_valida] = TRUE()))",
            "formatString": "0.0%",
            "lineageTag": "2d4e6ebd-5534-4afe-a9f7-25af39b8b176"
          },
          {
            "name": "OEE %",
            "displayFolder": "OEE",
            "expression": "DIVIDE([Tiempo bueno ideal válido],[Plan válido])",
            "formatString": "0.0%",
            "lineageTag": "b638e730-c1fa-403e-9d01-d74db1dd61a9"
          },
          {
            "name": "Estado OEE",
            "displayFolder": "OEE",
            "expression": "IF([Registros con OEE] = 0, \"No calculable\", FORMAT([OEE %], \"0.0%\"))",
            "formatString": "#,0",
            "lineageTag": "596768f0-1fc9-4c09-8eeb-06f64d0aeefe"
          },
          {
            "name": "Pareto acumulado %",
            "displayFolder": "Paros",
            "expression": "VAR Actual = [Minutos de paro]\nRETURN IF(ISINSCOPE(DimMotivo[subcausa]) && NOT ISINSCOPE(DimMotivo[causa]),\n VAR Causas = ADDCOLUMNS(ALLSELECTED(DimMotivo[subcausa]),\"@Minutos\",CALCULATE([Minutos de paro]))\n RETURN IF(NOT ISBLANK(Actual),DIVIDE(SUMX(FILTER(Causas,[@Minutos]>=Actual),[@Minutos]),SUMX(Causas,[@Minutos]))),\n IF(ISINSCOPE(DimMotivo[subcausa]),\n VAR Causas = ADDCOLUMNS(SUMMARIZE(ALLSELECTED(DimMotivo),DimMotivo[causa],DimMotivo[subcausa]),\"@Minutos\",CALCULATE([Minutos de paro]))\n RETURN IF(NOT ISBLANK(Actual),DIVIDE(SUMX(FILTER(Causas,[@Minutos]>=Actual),[@Minutos]),SUMX(Causas,[@Minutos]))),\n VAR Causas = ADDCOLUMNS(ALLSELECTED(DimMotivo[causa]),\"@Minutos\",[Minutos de paro])\n RETURN IF(NOT ISBLANK(Actual),DIVIDE(SUMX(FILTER(Causas,[@Minutos]>=Actual),[@Minutos]),SUMX(Causas,[@Minutos])))))",
            "formatString": "0.0%",
            "lineageTag": "944bcdff-f586-4d1e-84f2-8c4a8aa850dd"
          },
          {
            "name": "Disponibilidad mostrada",
            "displayFolder": "OEE",
            "expression": "IF(ISBLANK([Disponibilidad %]),\"Sin planificación\",FORMAT([Disponibilidad %],\"0.0%\"))",
            "lineageTag": "03cbba21-dff4-4395-b10a-43e3d7f8454a"
          },
          {
            "name": "Rendimiento mostrado",
            "displayFolder": "OEE",
            "expression": "IF(ISBLANK([Rendimiento %]),\"Sin vigencia\",FORMAT([Rendimiento %],\"0.0%\"))",
            "lineageTag": "6f738b67-70e3-4848-85cd-554815a9548c"
          },
          {
            "name": "Calidad mostrada",
            "displayFolder": "OEE",
            "expression": "IF(ISBLANK([Calidad unidades %]),\"Sin datos de calidad\",FORMAT([Calidad unidades %],\"0.0%\"))",
            "lineageTag": "df59a898-8367-4647-9264-dacf7e58e1a6"
          },
          {
            "name": "Registros con parámetros",
            "displayFolder": "Calidad de datos",
            "expression": "IF([Registros]>0,COALESCE(COUNTROWS(FILTER(FactProduccion,NOT ISBLANK(FactProduccion[unidades_ideales_por_minuto]) && NOT ISBLANK(FactProduccion[unidades_producidas]))),0))",
            "formatString": "#,0",
            "lineageTag": "151fc65b-eb49-4779-95c0-2d96db74075c"
          },
          {
            "name": "Registros con disponibilidad",
            "displayFolder": "OEE",
            "expression": "COALESCE(CALCULATE([Registros],FactProduccion[disponibilidad_valida]=TRUE()),0)",
            "formatString": "#,0",
            "lineageTag": "da9c3b5d-d071-44df-b749-ce1c48be350e"
          },
          {
            "name": "Cobertura disponibilidad %",
            "displayFolder": "OEE",
            "expression": "DIVIDE([Registros con disponibilidad],[Registros])",
            "formatString": "0.0%",
            "lineageTag": "e92912d2-abfb-4dc9-a2df-2269b7aad882"
          },
          {
            "name": "Productividad registrada %",
            "displayFolder": "OEE",
            "expression": "DIVIDE([Horas trabajadas]*60-[Minutos de paro],[Horas trabajadas]*60)",
            "formatString": "0.0%",
            "lineageTag": "cf0207a6-3105-455a-809f-6ccfa7a7ba5e"
          },
          {
            "name": "Registros nominales evaluables",
            "displayFolder": "Diagnóstico nominal",
            "expression": "IF([Registros]>0,COALESCE(COUNTROWS(FILTER(FactProduccion,NOT ISBLANK(FactProduccion[rendimiento_nominal]))),0))",
            "formatString": "#,0",
            "lineageTag": "f3cd59f1-73a0-4f61-a3ba-4510d7255b28"
          },
          {
            "name": "Nominal superior al 100 %",
            "displayFolder": "Diagnóstico nominal",
            "expression": "IF([Registros]>0,COALESCE(COUNTROWS(FILTER(FactProduccion,FactProduccion[rendimiento_nominal]>1)),0))",
            "formatString": "#,0",
            "lineageTag": "8faef489-67cd-4ea4-bfeb-ffa67f38469f"
          },
          {
            "name": "Rendimiento nominal diagnóstico %",
            "displayFolder": "Diagnóstico nominal",
            "expression": "VAR Filas = FILTER(FactProduccion,NOT ISBLANK(FactProduccion[rendimiento_nominal])) RETURN DIVIDE(SUMX(Filas,DIVIDE(FactProduccion[unidades_producidas],FactProduccion[unidades_ideales_por_minuto])),SUMX(Filas,FactProduccion[minutos_operativos]))",
            "formatString": "0.0%",
            "lineageTag": "13b4da84-59b1-4df9-92be-f5eead51ed86"
          },
          {
            "name": "Registros con parámetros confirmados",
            "displayFolder": "OEE",
            "expression": "COALESCE(CALCULATE([Registros],FactProduccion[parametros_confirmados]=TRUE()),0)",
            "formatString": "#,0",
            "lineageTag": "3c673607-f88d-49eb-8fd2-fbdd0f0395df"
          },
          {
            "name": "Pacas año anterior",
            "displayFolder": "Comparación anual",
            "expression": "IF(HASONEVALUE(DimFecha[anio]),CALCULATE([Pacas],SAMEPERIODLASTYEAR(DimFecha[fecha])))",
            "formatString": "#,0",
            "lineageTag": "f4c00aea-54fe-4322-a014-d5188fc8a089"
          },
          {
            "name": "Variación interanual pacas %",
            "displayFolder": "Comparación anual",
            "expression": "DIVIDE([Pacas]-[Pacas año anterior],[Pacas año anterior])",
            "formatString": "0.0%",
            "lineageTag": "e6c3e66f-fea4-4b4d-804e-91418206db56"
          },
          {
            "name": "Pacas año anterior mostradas",
            "displayFolder": "Comparación anual",
            "expression": "IF(NOT HASONEVALUE(DimFecha[anio]),\"Selecciona un año\",IF(ISBLANK([Pacas año anterior]),\"Sin comparativo\",FORMAT([Pacas año anterior],\"#,0\")))",
            "lineageTag": "34d781ba-c1fb-463a-a841-ae00374af9d4"
          },
          {
            "name": "Variación interanual mostrada",
            "displayFolder": "Comparación anual",
            "expression": "(IF(NOT HASONEVALUE(DimFecha[anio]),\"Selecciona un año\",IF(ISBLANK([Variación interanual pacas %]),\"Sin comparativo\",FORMAT([Variación interanual pacas %],\"0.0%\")))) & IF(HASONEVALUE(DimFecha[anio]) && SELECTEDVALUE(DimFecha[anio])=2025,\" (2025 parcial)\",\"\")",
            "lineageTag": "76d8e446-d998-4fc9-909f-86106a774ffb"
          }
        ],
        "partitions": [
          {
            "name": "FactProduccion",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Fuente = Odbc.Query(\"dsn=Taller5Docker\", \"SELECT * FROM bi.fact_produccion\"),",
                "    Tipos = Table.TransformColumns(Fuente, {{\"parametros_confirmados\", each if _ is logical then _ else Logical.From(Number.From(_)), type logical}, {\"disponibilidad_valida\", each if _ is logical then _ else Logical.From(Number.From(_)), type logical}, {\"rendimiento_valido\", each if _ is logical then _ else Logical.From(Number.From(_)), type logical}, {\"calidad_valida\", each if _ is logical then _ else Logical.From(Number.From(_)), type logical}, {\"oee_valido\", each if _ is logical then _ else Logical.From(Number.From(_)), type logical}})",
                "in Tipos"
              ],
              "type": "m"
            }
          }
        ]
      },
