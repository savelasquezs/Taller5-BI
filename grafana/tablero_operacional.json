          "rawSql": "SELECT m.maquina AS \"Máquina\",d.inicio,round(extract(epoch FROM(now()-d.inicio))/60,1) AS \"Minutos abierto\",c.causa FROM bi.fact_paros d JOIN bi.dim_maquina m USING(maquina_id) JOIN bi.dim_causa c USING(codigo_paro) WHERE d.fin IS NULL AND d.inicio IS NOT NULL AND d.maquina_id IN (${maquina:csv}) ORDER BY d.inicio",
