        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "taller5-postgres"
          },
          "rawSql": "WITH causas AS (SELECT c.causa AS \"Causa\",sum(p.duracion_minutos) AS \"Minutos\" FROM bi.fact_paros p JOIN bi.dim_causa c USING(codigo_paro) WHERE $__timeFilter(p.fecha) AND p.maquina_id IN (${maquina:csv}) GROUP BY c.codigo_paro,c.causa ORDER BY \"Minutos\" DESC,c.codigo_paro) SELECT \"Causa\",\"Minutos\",round(100.0*sum(\"Minutos\") OVER(ORDER BY \"Minutos\" DESC,\"Causa\")/nullif(sum(\"Minutos\") OVER(),0),2) AS \"Acumulado %\" FROM causas ORDER BY \"Minutos\" DESC,\"Causa\"",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
