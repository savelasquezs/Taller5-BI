          "rawSql": "WITH horas AS (SELECT sum(p.horas_trabajadas)*60 AS minutos_base FROM bi.fact_produccion p WHERE $__timeFilter(p.fecha) AND p.maquina_id IN (${maquina:csv})), causas AS (SELECT c.codigo_paro,c.causa,sum(p.duracion_minutos) AS minutos_paro FROM bi.fact_paros p JOIN bi.dim_causa c USING(codigo_paro) WHERE $__timeFilter(p.fecha) AND p.maquina_id IN (${maquina:csv}) GROUP BY c.codigo_paro,c.causa) SELECT left(c.causa,50) AS \"Código\",100*c.minutos_paro/nullif(h.minutos_base,0) AS \"Porcentaje sobre horas\" FROM causas c CROSS JOIN horas h ORDER BY \"Porcentaje sobre horas\" DESC,c.codigo_paro",
