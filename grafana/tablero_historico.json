    {
      "id": 6,
      "title": "Principales causas por minutos",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "taller5-postgres"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:min",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "barWidth": 0.8,
        "groupWidth": 0.8,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "taller5-postgres"
          },
          "rawSql": "SELECT left(c.causa,32) AS \"Causa\",sum(p.duracion_minutos) AS \"Minutos\" FROM bi.fact_paros p JOIN bi.dim_causa c USING(codigo_paro) WHERE $__timeFilter(p.fecha) AND p.maquina_id IN (${maquina:csv}) GROUP BY c.codigo_paro,c.causa ORDER BY \"Minutos\" DESC,c.codigo_paro LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 7,
      "title": "Pareto acumulado de causas",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
